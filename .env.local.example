ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_HI=     # setup voice "hi" — Hindi
ELEVENLABS_VOICE_ID_EN=     # setup voice "en" — English
ELEVENLABS_VOICE_ID=        # optional shared fallback if a voice's env is unset
# Add more voices in lib/voices.ts (id + elevenLabsId + optional envVar), then set that env here.

# LLM — Groq is the default (same Llama 3.3 70B, no IBM card needed)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional IBM watsonx (set LLM_PROVIDER=watsonx to use)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=meta-llama/llama-3-3-70b-instruct

WATSON_STT_API_KEY=
WATSON_STT_URL=
