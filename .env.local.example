ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_HI=     # optional fallback for unknown Hindi catalog ids
ELEVENLABS_VOICE_ID_EN=     # optional fallback for unknown English catalog ids
ELEVENLABS_VOICE_ID=        # optional shared fallback if a voice's env is unset
# Voices users can pick live in lib/voices.ts (premade IDs this key can use).

# LLM — Groq is the default (no IBM card needed)
# llama-3.3-70b-versatile was retired for free/developer keys on 2026-08-16.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional IBM watsonx (set LLM_PROVIDER=watsonx to use)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=meta-llama/llama-3-3-70b-instruct
