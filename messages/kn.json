    "land.eyebrow":  "ಒಂದು ರಿಲೇ, ಎರಡು ದಿಕ್ಕುಗಳು",
    "land.hero":  "ಭಾರತದ ಕಾಣೆಯಾದ ಫೋನ್ ರಿಲೇ.",
    "land.hero_body":  "ಮಾತನಾಡಲಾಗದ ಅಥವಾ ಕೇಳಲಾಗದ ಜನರು ಇನ್ನೂ ಸರಳ ಫೋನ್ ಕರೆಯಿಂದ ಹೊರಗಿದ್ದಾರೆ. ಸಂಪರ್ಕ್ ಅಧಿಕಾರಿಯ ಧ್ವನಿಯನ್ನು ಶೀರ್ಷಿಕೆಗಳಾಗಿ ಮಾಡುತ್ತದೆ. ನೀವು ಉತ್ತರ ಸೂಚನೆಯನ್ನು ಆಯ್ಕೆ ಮಾಡಿ, ಕಳುಹಿಸು ಒತ್ತಿದಾಗ ಮಾತ್ರ ಮಾತನಾಡುತ್ತದೆ.",
    "land.cta":  "ಸಂಪರ್ಕ್‌ನಿಂದ ಕರೆ ಮಾಡಿ",
    "land.same_line":  "ಅದೇ ಕರೆ, ಎರಡೂ ಕಡೆ",
    "land.lead":  "ನೀವು ನಡೆಸುತ್ತೀರಿ. ಸಂಪರ್ಕ್ ಸಂಭಾಷಣೆಯನ್ನು ಒಯ್ಯುತ್ತದೆ.",
    "land.lead_body":  "ಮುಖ್ಯ ಸಂಕೇತಗಳು ಪರದೆಯ ಮೇಲಿವೆ. ಲೈನ್‌ನಲ್ಲಿ ಏನಾಗುತ್ತಿದೆ ಎಂದು ಊಹಿಸಬೇಕಾಗಿಲ್ಲ.",
    "land.visible":  "ಮುಖ್ಯವಾದುದು ಯಾವುದೂ ಮರೆಯಾಗುವುದಿಲ್ಲ",
    "land.shape":  "ಪ್ರತಿ ಸಂಭಾಷಣೆಯ ಆಕಾರವನ್ನು ನೋಡಿ.",
    "land.shape_body":  "ಫೋನ್ ಕರೆ ಟ್ರಾನ್ಸ್ಕ್ರಿಪ್ಟ್ ಮಾತ್ರವಲ್ಲ. ಸಂಪರ್ಕ, ಮೌನ, ಇಟ್ಟುಕೊಳ್ಳಬೇಕಾದ ಸಂಖ್ಯೆ ಸ್ಪಷ್ಟವಾಗಿ ಕಾಣುತ್ತದೆ — ಕರೆ ಮುಗಿದಾಗ ಉಳಿಸಲಾಗುತ್ತದೆ.",
    "land.built":  "ಪ್ರವೇಶಕ್ಕಾಗಿ ನಿರ್ಮಿಸಲಾಗಿದೆ, ತಾತ್ಕಾಲಿಕ ಪರಿಹಾರಕ್ಕಾಗಿ ಅಲ್ಲ",
    "land.depend":  "ಕರೆಗಳು ಮಾತನಾಡುವ ಅಥವಾ ಕೇಳುವ ಸಾಮರ್ಥ್ಯದ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿರಬಾರದು.",
    "land.why_1":  "ಲೈನ್ ಸಕ್ರಿಯವಾಗಿದೆಯೇ, ಮೌನವಾಗಿದೆಯೇ, ಅಥವಾ ಕಡಿದಿದೆಯೇ ಎಂದು ನೋಡಿ — ಕೇಳಲಾಗದವರು ಹೋಲ್ಡ್ ಸಂಗೀತ ಕೇಳಲಾರರು.",
    "land.why_2":  "ಉತ್ತರ ಸೂಚನೆಗಳು ಸೂಚನೆಗಳಾಗಿಯೇ ಉಳಿಯುತ್ತವೆ. ಕಳುಹಿಸುವವರೆಗೆ ಏನೂ ಮಾತನಾಡುವುದಿಲ್ಲ.",
    "land.why_3":  "ಫಲಿತಾಂಶ ಕಾರ್ಡ್‌ನಲ್ಲಿ ದೂರು ಸಂಖ್ಯೆ ಮೇಲಿದೆ. ಪೂರ್ಣ ಸಂಭಾಷಣೆ ಮುಚ್ಚಿರುತ್ತದೆ.",
    "land.footer":  "ಕೇಳಲಾಗದ ಮತ್ತು ಮಾತನಾಡಲಾಗದ ಭಾರತಕ್ಕಾಗಿ ಫೋನ್ ರಿಲೇ",
    "land.step1_title":  "ಈ ಕರೆಗೆ ಬೇಕಾದ ವಿವರಗಳನ್ನು ಮಾತ್ರ ನಮೂದಿಸಿ",
    "land.step1_body":  "ಮೊದಲು ಪರಿಸ್ಥಿತಿ ಆಯ್ಕೆಮಾಡಿ. ನಂತರ ಗ್ರಾಹಕ ಸಂಖ್ಯೆ, ಪ್ರದೇಶ ಅಥವಾ ಬ್ಯಾಂಕ್ ವಿವರ — ನೀವು ಟೈಪ್ ಮಾಡಿದುದು ಮಾತ್ರ. Sampark ಸಂಖ್ಯೆ ಅಥವಾ ಹೆಸರನ್ನು ಕಲ್ಪಿಸುವುದಿಲ್ಲ.",
    "land.step2_title":  "ಪ್ರತಿ ಪದವನ್ನು ಓದಿ",
    "land.step2_body":  "ಅಧಿಕಾರಿಯ ಧ್ವನಿ ಶೀರ್ಷಿಕೆಗಳಾಗುತ್ತದೆ. ಸೈಲೆನ್ಸ್ ರಿಂಗ್ ಲೈನ್ ಸಕ್ರಿಯವಾಗಿದೆಯೇ, ಮೌನವಾಗಿದೆಯೇ, ಅಥವಾ ಹೋಗಿದೆಯೇ ಎಂದು ತೋರಿಸುತ್ತದೆ.",
    "land.step3_title":  "ಉತ್ತರವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ನಂತರ ಕಳುಹಿಸಿ.",
    "land.step3_body":  "ನೀವು ಆ ವಾಕ್ಯವನ್ನು ಒಪ್ಪುವವರೆಗೆ ಏನೂ ಮಾತನಾಡುವುದಿಲ್ಲ. OTP, PIN, CVV, ಪಾಸ್‌ವರ್ಡ್ ಎಂದಿಗೂ ಮಾತನಾಡುವುದಿಲ್ಲ.",
    "land.tl1_time":  "00:00",
    "land.tl1_title":  "ನೀವು ಕರೆ ಒತ್ತುತ್ತೀರಿ",
    "land.tl1_body":  "ಸಂಪರ್ಕ್ ಲೈನ್ ತೆರೆಯುತ್ತದೆ. ಮೊದಲ ವಾಕ್ಯ ನಿಮ್ಮನ್ನು ಸಹಾಯಕ ರಿಲೇ ಎಂದು ಪರಿಚಯಿಸುತ್ತದೆ.",
